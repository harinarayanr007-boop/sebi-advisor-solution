# ==============================================================================
# 1. SUPABASE DATABASE & BACKEND (Aurum Fiduciary Cloud Persistence)
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. In Project Settings -> API, copy Project URL and Project API Anon Key
# 3. Paste them below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional (for elevated server-side operations):
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. RESEND EMAIL CONFIGURATION (Advisory Consultation Desk)
# ==============================================================================
# 1. Sign up for a free Resend account at https://resend.com
# 2. Go to https://resend.com/api-keys and click "Create API Key"
# 3. Paste your key below:
RESEND_API_KEY=

# The email address where the advisor wants to receive lead alerts & briefings:
ADVISOR_NOTIFICATION_EMAIL=advice@sebiadvisor.in

# Default sender address:
# Resend Free Sandbox uses: onboarding@resend.dev
RESEND_FROM_EMAIL=Aurum Fiduciary Desk <onboarding@resend.dev>
